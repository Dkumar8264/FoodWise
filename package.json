{
  "name": "foodwise",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ml",
    "test:backend": "node --test server/test/analytics.test.js",
    "test:frontend": "node --test client/test/api.test.js",
    "test:ml": "python ml-service/tests/test_features.py"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
